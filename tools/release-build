#!/usr/bin/env node
// Builds the release files a repository describes in .factory/release-build.yaml, or else in the recipe stored in the
// Foundry settings of $FACTORY_VAR_GITHUB_REPO (the logic is in src/release/).
//   release-build resolve <run-dir>                 resolve $FACTORY_VAR_REF in the current folder (a clone), find the
//                                                   recipe (file at that commit, else stored), write <run-dir>/release/plan.json
//   release-build build <run-dir> <test-slots-dir>  run the builds of that plan, one after the other, each in its own
//                                                   git worktree; the release files end up in <run-dir>/release/out
// Build commands get a short environment and no tokens (see src/release/host.ts).
import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { fileURLToPath } from "node:url";

const lib = (name) => import(new URL(`../dist/release/${name}.js`, import.meta.url).href);
const [mode, runDir, slotsDir] = process.argv.slice(2);
const fail = (msg) => {
  console.error(`release-build: ${msg}`);
  process.exit(1);
};
if (!runDir || (mode !== "resolve" && mode !== "build") || (mode === "build" && !slotsDir)) {
  console.error("usage: release-build resolve <run-dir> | release-build build <run-dir> <test-slots-dir>");
  process.exit(2);
}
const planFile = join(runDir, "release", "plan.json");

try {
  if (mode === "resolve") {
    const { resolveCommit } = await lib("build");
    const { expandVersion, expandTag, loadReleaseRecipe, RECIPE_SOURCE_TEXT } = await lib("recipe");
    const commit = resolveCommit(process.cwd(), process.env.FACTORY_VAR_REF || "main");
    const { recipe, source } = loadReleaseRecipe(process.env.FACTORY_VAR_GITHUB_REPO ?? "", process.cwd(), commit.sha);
    const plan = {
      sha: commit.sha,
      recipeSource: source,
      version: expandVersion(recipe, commit),
      tag: expandTag(recipe, commit),
      prerelease: recipe.prerelease,
      keep: recipe.keep,
      recipe,
    };
    mkdirSync(join(runDir, "release"), { recursive: true });
    writeFileSync(planFile, JSON.stringify(plan, null, 2));
    console.log(`recipe: ${RECIPE_SOURCE_TEXT[source]}`);
    console.log(`COMMIT: ${plan.sha}`);
    console.log(`VERSION: ${plan.version}`);
    console.log(`TAG: ${plan.tag}`);
    console.log(`BUILDS: ${recipe.builds.map((b) => b.name).join(", ")}`);
  } else {
    const { runRelease } = await lib("build");
    const { hostOf, deniedNames } = await lib("host");
    // The settings name the variables that hold tokens and keys (any name). Without them a token could pass as an
    // allowed name, so a settings file that cannot be read stops the run. No settings file at all means the built-in names.
    let denied;
    try {
      const { loadConfig } = await import(new URL("../dist/config.js", import.meta.url).href);
      denied = deniedNames(loadConfig());
    } catch (e) {
      throw new Error(`the settings cannot be read, so the names of secret variables are not known: ${e.message.split("\n")[0]}`);
    }
    const plan = JSON.parse(readFileSync(planFile, "utf8"));
    const stop = new AbortController();
    for (const sig of ["SIGTERM", "SIGINT", "SIGHUP"]) process.on(sig, () => stop.abort());
    const ok = await runRelease({
      repoDir: process.cwd(),
      runDir,
      slotsDir,
      testSlot: fileURLToPath(new URL("./test-slot", import.meta.url)),
      plan,
      host: hostOf(),
      env: process.env,
      denied,
      signal: stop.signal,
      log: (line) => console.log(line),
    });
    process.exitCode = ok ? 0 : 1;
  }
} catch (e) {
  fail(e.message);
}
