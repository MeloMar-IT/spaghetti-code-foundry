  tracker?.stop();
  release();
  console.error(`test-slot: cannot run ${cmd}: ${e.message}`);
  process.exit(127);
});
child.on("exit", (code, signal) => {
  if (stopping) return; // the stop at the limit owns the exit
  clearTimeout(limitTimer);
  stopPause();
  tracker?.stop();
  void writeTrack(pt, tracker).finally(() => {
    release();
    process.exit(code ?? (signal ? 1 : 0));
  });
});
