#!/usr/bin/env node
// Makes sure the tests of a step really ran.
//   test-env docker <run-dir> <test-cmd>   before the tests: when they need Docker, check that it answers; on macOS start
//        Docker Desktop and wait. Exit 1 with "Docker did not start" when it does not come up.
//   test-env check <marker> <run-dir>      after the tests: exit 1 when container tests did not run (read from
//        <run-dir>/tests.log and the JUnit reports written after <marker>), or when the test run hung twice. A refused Docker
//        API version also writes <run-dir>/docker-api.json (the server files one bug story from it).
//   test-env silence <command> [args…]     run a command; stop it and run it once more when it prints nothing for too long
//        (see tools/test-silence.mjs). Used around tools/test-slot.
// On exit 1 of `docker` and `check` the reason is written to FACTORY_ENV_STOP_FILE (set by the engine for each step;
// <run-dir>/env-stop.txt without it): the run then ends at the step and on_failure is not followed.
// "The tests need Docker": a build file (at most 3 folders deep) mentions Testcontainers or Docker Compose, or the test
// command names docker.
// The files are read whole, in pieces of 256 KB, with the last 64 KB of each piece searched again with the next one (a sign
// cut by a piece boundary is found). A file that cannot be read stops the step: nothing unread counts as tested.
// Env: FACTORY_DOCKER_BIN (docker), FACTORY_OPEN_BIN (open), FACTORY_DOCKER_PLATFORM (this platform; only "darwin" starts
//      Docker Desktop), FACTORY_DOCKER_WAIT_SEC (longest wait for the start; 180), FACTORY_DOCKER_POLL_MS (5000).
import { execFile } from "node:child_process";
import { closeSync, fstatSync, openSync, readdirSync, readFileSync, readSync, statSync, writeFileSync } from "node:fs";
import { basename, join, relative } from "node:path";
import { StringDecoder } from "node:string_decoder";

const USAGE = "usage: test-env docker <run-dir> <test-cmd> | check <marker> <run-dir> | silence <command> [args…]";
const INFO_LIMIT_MS = 20_000;
const MAX_DEPTH = 3;
/** Build files are read whole up to this size; the test output and the reports are read in pieces. */
const MAX_READ = 20 * 1024 * 1024;
const CHUNK = 256 * 1024;
/** A sign that is at most this long is found even when a piece boundary cuts it. */
const OVERLAP = 64 * 1024;
const SKIP_DIRS = new Set(["node_modules", ".git", "build", "target"]);
const BUILD_FILE = /^(pom\.xml|build\.gradle|build\.gradle\.kts|libs\.versions\.toml|package\.json|pyproject\.toml|requirements.*\.txt|go\.mod)$/;
const NEEDS = [[/testcontainers/i, "Testcontainers"], [/spring-boot-docker-compose|docker-compose/i, "Docker Compose"]];
/** The first Testcontainers Java versions that work with an Engine that refuses API versions below `minApi`. */
const API_TABLE = [{ minApi: "1.44", "1.x": "1.21.4", "2.x": "2.0.2" }];
const VERSION = /^\d+\.\d+(\.\d+)?([.-][A-Za-z0-9]+)?$/;
const NO_DOCKER_ENV = "Could not find a valid Docker environment";
const API_REFUSED = /client version (\d{1,3}\.\d{1,3}) is too old\.\s*Minimum supported API version is (\d{1,3}\.\d{1,3})/i;

const num = (v, d) => (/^\d+$/.test(v ?? "") ? Number(v) : d);

/** The text of a small build file (the first `MAX_READ` bytes); "" when it cannot be read. */
function readText(file) {
  let fd;
  try {
    if (!statSync(file).isFile()) return "";
    fd = openSync(file, "r");
    const buf = Buffer.alloc(Math.min(fstatSync(fd).size, MAX_READ));
    return buf.toString("utf8", 0, readSync(fd, buf, 0, buf.length, 0));
  } catch {
    return "";
  } finally {
    if (fd !== undefined) closeSync(fd);
  }
}

/** The last line of a file (its last 4 KB are read); "" when it cannot be read. */
function lastLine(file) {
  let fd;
  try {
    fd = openSync(file, "r");
    const size = fstatSync(fd).size;
    const buf = Buffer.alloc(Math.min(size, 4096));
    const n = readSync(fd, buf, 0, buf.length, size - buf.length);
    return buf.toString("utf8", 0, n).trimEnd().split("\n").at(-1) ?? "";
  } catch {
    return "";
  } finally {
    if (fd !== undefined) closeSync(fd);
  }
}

/**
 * The first result of `find` over the whole file, read in pieces: each piece is searched together with the end of the one
 * before it, so memory stays bounded and no sign is skipped. Undefined when there is none. Throws when the file cannot be read.
 */
function scanFile(file, find) {
  let fd;
  try {
    fd = openSync(file, "r");
    const buf = Buffer.alloc(CHUNK);
    const decoder = new StringDecoder("utf8");
    let carry = "";
    for (;;) {
      const n = readSync(fd, buf, 0, CHUNK, null);
      if (n === 0) break;
      const window = carry + decoder.write(buf.subarray(0, n));
      const hit = find(window);
      if (hit) return hit;
      carry = window.slice(-OVERLAP);
    }
    const rest = decoder.end();
    return rest ? find(carry + rest) : undefined;
  } finally {
    if (fd !== undefined) closeSync(fd);
  }
}

/** Calls `each` for every file at most `depth` folders below `root` whose folder is not skipped. */
function walk(root, depth, skip, each, level = 0) {
  let entries;
  try {
    entries = readdirSync(root, { withFileTypes: true });
  } catch {
    return;
  }
  for (const e of entries.sort((a, b) => (a.name < b.name ? -1 : 1))) {
    const p = join(root, e.name);
    if (e.isDirectory()) {
      if (level < depth && !skip.has(e.name)) walk(p, depth, skip, each, level + 1);
    } else if (e.isFile()) each(p, e.name);
  }
}

/** The build files of the repository, those nearest to the root first. */
function buildFiles(root) {
  const found = [];
  walk(root, MAX_DEPTH, SKIP_DIRS, (path, name) => {
    if (!BUILD_FILE.test(name)) return;
    const rel = relative(root, path);
    if (name === "libs.versions.toml" && !/(^|\/)gradle\/libs\.versions\.toml$/.test(rel)) return;
    found.push({ path, name, rel });
  });
  return found.sort((a, b) => a.rel.split("/").length - b.rel.split("/").length);
}

/** Why the tests need Docker ("Testcontainers in pom.xml"); undefined when they do not. */
function needsDocker(root, cmd) {
  if (/(^|[\s;&|()'"`/])docker(-compose)?($|[\s;&|()'"`])/.test(cmd)) return "the test command names docker";
  for (const f of buildFiles(root)) {
    const text = readText(f.path);
    const hit = NEEDS.find(([re]) => re.test(text));
    if (hit) return `${hit[1]} in ${f.rel}`;
  }
  return undefined;
}

const VERSION_PATTERNS = {
  "pom.xml": [
    /<testcontainers[.-]version>\s*([^<\s]+)\s*<\/testcontainers[.-]version>/,
    /<groupId>\s*org\.testcontainers\s*<\/groupId>\s*<artifactId>[^<]*<\/artifactId>\s*<version>\s*([^<$\s]+)\s*<\/version>/,
  ],
  gradle: [/org\.testcontainers:[A-Za-z0-9_-]+:([0-9][^"'\s)]*)/, /testcontainers[._-]?[Vv]ersion["']?\s*(?:=|,|to)\s*["']([^"']+)["']/],
  "libs.versions.toml": [/^\s*testcontainers(?:[._-]?[Vv]ersion)?\s*=\s*["']([^"']+)["']/m, /org\.testcontainers:[A-Za-z0-9_-]+:([0-9][^"'\s)]*)/],
};

/** Whether Testcontainers is used, and the version (only from Maven and Gradle files, only a text that looks like one). */
function testcontainersVersion(root) {
  let used = false;
  for (const f of buildFiles(root)) {
    const text = readText(f.path);
    if (!/testcontainers/i.test(text)) continue;
    used = true;
    const patterns = VERSION_PATTERNS[f.name.startsWith("build.gradle") ? "gradle" : f.name] ?? [];
    for (const re of patterns) {
      const v = re.exec(text)?.[1];
      if (v && v.length <= 40 && VERSION.test(v)) return { used, version: v, file: f.name === "libs.versions.toml" ? "gradle/libs.versions.toml" : f.name };
    }
  }
  return { used };
}

/** A sign in test output that container tests could not run; undefined when there is none. */
function containerSkips(text) {
  const api = API_REFUSED.exec(text);
  if (api) return { cause: `Docker refused the API version ${api[1]}; the Engine needs ${api[2]} or newer`, api: { client: api[1], min: api[2] } };
  if (text.includes(NO_DOCKER_ENV)) return { cause: "Testcontainers could not find a valid Docker environment" };
  return undefined;
}

/**
 * A skipped test whose message says Docker is not available (`@Testcontainers(disabledWithoutDocker = true)`). Only the
 * opening tag is read (bounded), so the message is found in any piece that holds the tag.
 */
function dockerSkip(text) {
  for (const m of text.matchAll(/<skipped\b([^>]{0,4096})>/g)) {
    const message = /\bmessage="([^"]{0,2048})"/.exec(m[1])?.[1] ?? "";
    if (/docker/i.test(message) && /not available|unavailable/i.test(message)) return { cause: "tests were skipped because Docker is not available" };
  }
  return undefined;
}

/** Output and reports together: the signs of a container that did not run. */
const skipsIn = (text) => containerSkips(text) ?? dockerSkip(text);

/** The JUnit reports written after the marker (the same walk as tools/test-summary). */
function reports(marker) {
  let since = 0;
  try {
    since = statSync(marker).mtimeMs - 1000;
  } catch { /* no marker: every report counts */ }
  const files = [];
  walk(".", 8, new Set(["node_modules", ".git", ".gradle"]), (path, name) => {
    try {
      if (/^TEST-.*\.xml$|^junit.*\.xml$/.test(name) && statSync(path).mtimeMs >= since) files.push(path);
    } catch { /* gone meanwhile */ }
  });
  return files;
}

/** Prints the reason, notes it for the engine and exits 1. */
function stop(runDir, reason) {
  console.log(`test-env: ${reason}`);
  try {
    writeFileSync(process.env.FACTORY_ENV_STOP_FILE || join(runDir, "env-stop.txt"), `${reason}\n`);
  } catch (e) {
    console.log(`test-env: the reason could not be noted (${e.code ?? "error"})`);
  }
  process.exitCode = 1;
}

/** The version of the Docker Engine when it answers; undefined when it does not. */
function engineVersion(limitMs = INFO_LIMIT_MS) {
  return new Promise((resolve) => {
    execFile(process.env.FACTORY_DOCKER_BIN || "docker", ["info", "--format", "{{.ServerVersion}}"], { timeout: limitMs, killSignal: "SIGKILL" }, (err, stdout) => {
      resolve(err ? undefined : String(stdout).trim() || undefined);
    });
  });
}

const run = (bin, args) => new Promise((resolve) => execFile(bin, args, { timeout: INFO_LIMIT_MS }, (err) => resolve(!err)));

async function docker(runDir, cmd) {
  const why = needsDocker(".", cmd);
  if (!why) return;
  console.log(`test-env: the tests need Docker (${why})`);
  if (await engineVersion()) {
    console.log("test-env: Docker answers");
    return;
  }
  if ((process.env.FACTORY_DOCKER_PLATFORM || process.platform) !== "darwin") {
    return stop(runDir, "Docker did not start: it does not answer, and the Foundry starts it only on macOS");
  }
  console.log("test-env: Docker does not answer — starting Docker Desktop");
  if (!(await run(process.env.FACTORY_OPEN_BIN || "open", ["-a", "Docker"]))) {
    return stop(runDir, "Docker did not start: Docker Desktop could not be opened");
  }
  const waitMs = num(process.env.FACTORY_DOCKER_WAIT_SEC, 180) * 1000;
  const pollMs = num(process.env.FACTORY_DOCKER_POLL_MS, 5000) || 5000;
  const from = Date.now();
  while (Date.now() - from < waitMs) {
    await new Promise((r) => setTimeout(r, Math.min(pollMs, Math.max(1, waitMs - (Date.now() - from)))));
    if (await engineVersion(Math.min(INFO_LIMIT_MS, Math.max(1000, waitMs - (Date.now() - from))))) {
      console.log(`test-env: Docker answered after ${Math.round((Date.now() - from) / 1000)} s`);
      return;
    }
  }
  return stop(runDir, `Docker did not start: no answer ${Math.round(waitMs / 1000)} s after Docker Desktop was started`);
}

async function writeDockerApi(runDir, api) {
  const tc = testcontainersVersion(".");
  if (!tc.used) return;
  const row = API_TABLE.find((r) => r.minApi === api.min);
  const engine = await engineVersion();
  const fact = {
    version: 1,
    ...(tc.version ? { testcontainers: tc.version, buildFile: basename(tc.file) === "libs.versions.toml" ? "gradle/libs.versions.toml" : tc.file } : {}),
    clientApi: api.client,
    minApi: api.min,
    ...(engine && VERSION.test(engine) ? { engine } : {}),
    ...(row ? { firstWorking: { "1.x": row["1.x"], "2.x": row["2.x"] } } : {}),
    at: new Date().toISOString(),
  };
  try {
    writeFileSync(join(runDir, "docker-api.json"), JSON.stringify(fact));
  } catch (e) {
    console.log(`test-env: the version facts could not be written (${e.code ?? "error"})`);
  }
}

async function check(marker, runDir) {
  const log = join(runDir, "tests.log");
  const hung = /^test-silence: stopped — no output for (\d+) min, (twice|and )/.exec(lastLine(log));
  if (hung) {
    return stop(runDir, hung[2] === "twice" ? `the tests hung: no output for ${hung[1]} minutes, twice` : `the tests hung: no output for ${hung[1]} minutes, and they could not be stopped`);
  }
  try {
    let found = scanFile(log, containerSkips);
    for (const f of reports(marker)) {
      if (found?.api) break;
      const here = scanFile(f, skipsIn);
      // a refused API version says the most: it wins over the other signs
      if (here && (!found || here.api)) found = here;
    }
    if (!found) return;
    if (found.api) await writeDockerApi(runDir, found.api);
    return stop(runDir, `not tested: the container tests did not run (${found.cause})`);
  } catch (e) {
    return stop(runDir, `not tested: the test output could not be read (${e.code ?? "error"})`);
  }
}

const [mode, ...rest] = process.argv.slice(2);
if (mode === "docker" && rest.length === 2) await docker(rest[0], rest[1]);
else if (mode === "check" && rest.length === 2) await check(rest[0], rest[1]);
else if (mode === "silence" && rest.length) {
  const { silence } = await import("./test-silence.mjs");
  process.exitCode = await silence(rest[0], rest.slice(1));
} else {
  console.error(USAGE);
  process.exitCode = 2;
}
